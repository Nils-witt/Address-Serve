POSTGRES_HOST=localhost
POSTGRES_PORT=5438
POSTGRES_USER=address_serv
POSTGRES_PASSWORD=address_serv
POSTGRES_DB=address_serv
LISTEN_ADDR=:8080
# Write requests require a bearer token issued by this OpenID Connect provider.
OIDC_ISSUER_URL=https://auth.example.com/realms/example
OIDC_AUDIENCE=address-serv
# Optional: override the JWKS URL found via OpenID discovery.
# OIDC_JWKS_URL=
# Web UI (served at /ui/): the public OIDC client the browser signs in with,
# using the authorization code flow with PKCE. Register <base URL>/ui/callback
# as a redirect URI and <base URL>/ui/login as a post-logout redirect URI. The
# client's access tokens must carry OIDC_AUDIENCE in "aud".
# Defaults to OIDC_AUDIENCE.
# OIDC_CLIENT_ID=
# OIDC_SCOPE=openid profile email
