POSTGRES_HOST=localhost
POSTGRES_PORT=5438
POSTGRES_USER=address_serv
POSTGRES_PASSWORD=address_serv
POSTGRES_DB=address_serv
LISTEN_ADDR=:8080
# Write requests require a bearer token issued by this OpenID Connect provider.
OIDC_ISSUER_URL=https://auth.example.com/realms/example
OIDC_AUDIENCE=address-serv
# Optional: override the JWKS URL found via OpenID discovery.
# OIDC_JWKS_URL=
# Web UI (served at /ui/): the public OIDC client the browser signs in with,
# using the authorization code flow with PKCE. Register <base URL>/ui/callback
# as a redirect URI and <base URL>/ui/login as a post-logout redirect URI. The
# client's access tokens must carry OIDC_AUDIENCE in "aud".
# Defaults to OIDC_AUDIENCE.
# OIDC_CLIENT_ID=
# OIDC_SCOPE=openid profile email
# Collectors: executables that return addresses to sync, see
# docs/collectors/contract.md. Defaults to a "collectors" folder next to the
# binary, which with `go run` is a build cache folder, so set it then.
# COLLECTORS_DIR=./collectors
# Who may manage collectors: members of this group, as listed in the OIDC
# token's "groups" claim (Authentik sends it; in Keycloak, add a group
# membership mapper). Unset, nobody can, and API tokens never can.
# COLLECTOR_ADMIN_GROUP=address-serv-admins
# A run's collector process is killed after this long (Go duration).
# COLLECTOR_TIMEOUT=10m
# Geo objects without a usable address are attached to the nearest house
# number within this many metres; 0 disables that.
# COLLECTOR_GEO_MAX_DISTANCE_M=100
# Runs kept per collector.
# COLLECTOR_RUN_HISTORY=50
